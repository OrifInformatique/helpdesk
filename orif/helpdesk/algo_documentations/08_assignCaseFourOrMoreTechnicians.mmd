---
config:
  theme: redux-dark
  layout: dagre
---
%% Sous-processus détaillé du fichier 06_generateNextWeekPlanning_attribution.mmd
%% Appelé lorsque CASE 4 or more techniciens disponibles
flowchart TD
    p1[["→ Attribution"]]
    subgraph s1["assignCaseFourOrMoreTechnicians()"]
        n1["Foreach user_id"]
        n2["IF user_id max_assignation as first_technician is reach:"]
        n3["YES: CONTINUE"]
        n4["NO:"]
        n5["Assign this user_id to this period as first_technician"]
        n6["Increment this user_id assigned_first_technician with +1"]
        n7["Repeate for second_technician and third_technician"]
  end
    back1[["← Attribution"]]

    p1 --> s1
    n1 --> n2
    n2 --> n3 & n4
    n3 -.-> n1
    n4 --> n5
    n5 --> n6
    n6 --> n7
    n7 -.-> n1
    n7 --> back1

%% Lien de retour vers le fichier parent
click back1 "06_generateNextWeekPlanning_attribution.mmd" "Retour à la logique d'attribution principale"

