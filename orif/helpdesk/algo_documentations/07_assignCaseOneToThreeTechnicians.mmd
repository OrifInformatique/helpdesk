config:
  theme: redux-dark
  layout: dagre
---
%% Sous-processus détaillé du fichier 06_generateNextWeekPlanning_attribution.mmd
%% Appelé lorsque CASE 1 to 3 techniciens disponibles
flowchart TD
    p1[["→ Attribution"]]
    subgraph s1["assignCaseOneToThreeTechnicians()"]
        n1["Foreach available_first_technician"]
        n2["IF user_id max_assignation as first_technician is reach:"]
        n3["YES: CONTINUE"]
        n4["NO:"]
        n5["Assign this user_id to this period as first_technician"]
        n6["Increment this user_id assigned_first_technician with +1"]
        n7["IF available_second_technician is more or egal to 2"]
        n8["NO: CONTINUE"]
        n9["YES:"]
        n10["IF user_id is egal to first_technician in this period:"]
        n11["YES: CONTINUE"]
        n12["NO:"]
        n13["Foreach available_second_technician"]
        n14["IF user_id max_assign_second_technician is reach:"]
        n15["YES: CONTINUE"]
        n16["NO:"]
        n17["Assign this user_id to this period as second_technician"]
        n18["Increment this user_id assigned_second_technician with +1"]
        n19["IF available_third_technician is more or egal to 3"]
        n20["NO: CONTINUE"]
        n21["YES:"]
        n22["Foreach available_third_technician"]
        n23["IF user_id is egal to first_technician of second_technician in this period:"]
        n24["YES: CONTINUE"]
        n25["NO:"]
        n26["IF user_id max_assign_third_technician is reach:"]
        n27["YES: CONTINUE"]
        n28["NO:"]
        n29["Assign this user_id to this period as third_technician"]
        n30["Increment this user_id assigned_third_technician with +1"]
  end
    back1[["← Attribution"]]

    p1 --> s1
    n1 --> n2
    n2 --> n3 & n4
    n3 -.-> n1
    n4 --> n5
    n5 --> n6
    n6 --> n7
    n7 --> n8 & n9
    n8 -.-> n1
    n9 --> n13
    n10 --> n11 & n12
    n13 --> n10
    n11 -.-> n13
    n12 --> n14
    n14 --> n15 & n16
    n15 -.-> n13
    n16 --> n17
    n17 --> n18
    n18 --> n19
    n19 --> n20 & n21
    n20 -.-> n1
    n21 --> n22
    n22 --> n23
    n23 --> n24 & n25
    n24 -.-> n22
    n25 --> n26
    n26 --> n27 & n28
    n27 -.-> n22
    n28 --> n29
    n29 --> n30
    n30 --> back1

%% Lien de retour vers le fichier parent
click back1 "06_generateNextWeekPlanning_attribution.mmd" "Retour à la logique d'attribution principale"

